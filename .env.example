# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_default_chat_id_here

# Optional: Webhook mode (leave empty to use polling)
WEBHOOK_URL=https://your-domain.com/webhook
PORT=8000

# API Keys (required only for the data sources you want to enable)
SOLSCAN_API_KEY=your_solscan_api_key_here
RUGCHECK_API_KEY=your_rugcheck_api_key_here
X_BEARER_TOKEN=your_x_api_bearer_token_here
CODEX_API_KEY=your_codex_api_key_here
BITQUERY_API_KEY=your_bitquery_api_key_here
BUBBLEMAPS_API_KEY=your_bubblemaps_api_key_here

# Robinhood Chain (Arbitrum Orbit L2)
ENABLE_PONS_ROBINHOOD=true
ENABLE_NOXA_ROBINHOOD=true
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Bot Behavior
ALERT_COOLDOWN_SECONDS=300
MIN_CONFIDENCE=0.2
MIN_MARKET_CAP=5000
MIN_VOLUME_24H=0
SUBSCRIPTION_MODE=all
LOG_LEVEL=INFO
