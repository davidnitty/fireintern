# ============================================================
#  Fire Intern — production config (PRIVATE repo)
#  Everything pre-filled. On the host you only need to set:
#      TELEGRAM_BOT_TOKEN
#  (and TELEGRAM_CHAT_ID / TELEGRAM_CHAT_IDS if they change)
# ============================================================

TELEGRAM_BOT_TOKEN=

# --- Alert destinations ---
TELEGRAM_CHAT_ID=-100
TELEGRAM_CHAT_IDS=-100

# --- Chains / discovery ---
# Solana off for now — flip to true to re-enable Solana calls
ENABLE_SOLANA_ALERTS=false
ENABLE_PONS_ROBINHOOD=true
ENABLE_NOXA_ROBINHOOD=true
ENABLE_DIRECT_DISCOVERY=true

# --- Storage (Railway volume mounted at /data) ---
DB_PATH=/data/memecoin_alert_bot.db
ALERT_ONCE_PER_MINT=true

# --- Quality filters ---
MIN_MARKET_CAP=10000
MAX_MARKET_CAP=100000
MIN_CONFIDENCE=0.35
MIN_VOLUME_24H=0
SOL_USD=170
SUBSCRIPTION_MODE=all

# --- Safety (honeypot defence) ---
EVM_BLOCK_ON_RISK=true
EVM_REQUIRE_SELL_VERIFIED=false

# --- Price-increase updates (moon) ---
# First update at +50%, then on each doubling of the multiple
MOON_UPDATE_PCT=50
MOON_UPDATE_MODE=ladder

# --- Buy buttons / referrals ---
MAESTRO_URL_TEMPLATE=https://t.me/maestro?start={ref}-{ca}
MAESTRO_REFERRAL=r-nittyberry0
BLOOM_URL_TEMPLATE=https://telegram.me/BloomEVMbot?start=ref_5I0QKYENJB_{ca}
BASED_URL_TEMPLATE=https://t.me/based_eth_bot?start=r_nittyberry0_{ca}

# --- Optional API keys (work without, upgrade when added) ---
RUGCHECK_API_KEY=
SOLSCAN_API_KEY=
X_BEARER_TOKEN=
BITQUERY_API_KEY=
BUBBLEMAPS_API_KEY=

# --- Runtime ---
# WEBHOOK_URL must stay empty (Telegram polling mode)
WEBHOOK_URL=
PORT=8000
LOG_LEVEL=INFO
