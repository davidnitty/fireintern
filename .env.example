# Telegram Bot Configuration
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
# Comma-separated extra groups/chats that also receive alerts
TELEGRAM_CHAT_IDS=

# Optional: Webhook mode (leave empty to use polling)
WEBHOOK_URL=https://your-domain.com/webhook
PORT=8000

# API Keys (required only for the data sources you want to enable)
SOLSCAN_API_KEY=
RUGCHECK_API_KEY=
X_BEARER_TOKEN=
CODEX_API_KEY=
BITQUERY_API_KEY=
BUBBLEMAPS_API_KEY=
# GMGN official OpenAPI key — apply at https://gmgn.ai/ai
# Enables: Trenches discovery (sol + robinhood), token security/smart-money
# enrichment, exact top-10 holder data
GMGN_API_KEY=

# Robinhood Chain (Arbitrum Orbit L2)
ENABLE_PONS_ROBINHOOD=true
ENABLE_NOXA_ROBINHOOD=true
ENABLE_DIRECT_DISCOVERY=true
ROBINHOOD_RPC_URL=https://rpc.mainnet.chain.robinhood.com

# Solana — set false to silence Solana entirely (Robinhood keeps running)
ENABLE_SOLANA_ALERTS=true

# Bot Behavior
ALERT_COOLDOWN_SECONDS=300
MIN_CONFIDENCE=0.35
MIN_MARKET_CAP=10000
# 0 = no ceiling; set 100000 to focus on the 10k-100k band
MAX_MARKET_CAP=0
MIN_VOLUME_24H=0
SOL_USD=170
# Trading-bot deep links. {ca} is replaced with the token contract address.
# If a bot doesn't auto-load the CA, tweak the separator here (e.g. - _ or nothing).
BLOOM_URL_TEMPLATE=https://telegram.me/BloomEVMbot?start=ref_5I0QKYENJB_{ca}
BASED_URL_TEMPLATE=https://t.me/based_eth_bot?start=r_nittyberry0_{ca}
# Follow-up "is up NX" update threshold (% gain on an alerted token)
MOON_UPDATE_PCT=50
SUBSCRIPTION_MODE=all
LOG_LEVEL=INFO
